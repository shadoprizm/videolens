{
  "manifest_version": 3,
  "name": "VideoLens — AI Video Analysis",
  "version": "0.1.0",
  "description": "Analyze any video with AI: timestamped findings, bug repro steps, meeting notes, UX friction. Uses your own OpenAI key.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.lemonsqueezy.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open VideoLens"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
