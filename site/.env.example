# Public account configuration (the publishable key is safe for browser use).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential. Never expose this in site HTML or extension code.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Server-managed OpenAI account used only for Pro / Managed analysis.
OPENAI_API_KEY=sk-replace_me

# Generate at least 32 random characters, e.g. `openssl rand -base64 48`.
VIDEOLENS_EXTENSION_JWT_SECRET=replace_with_a_long_random_secret
VIDEOLENS_SITE_URL=https://videolens.io

# Stripe subscription product, prices, and webhook signing secret.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRODUCT_ID=prod_replace_me
STRIPE_PRO_MONTHLY_PRICE_ID=price_replace_me
STRIPE_PRO_ANNUAL_PRICE_ID=price_replace_me
