{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.6.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*.youtube.com/*",
    "https://videolens.io/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "open_at_install": true
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "videolens@videolens.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ],
        "optional": [
          "personallyIdentifyingInfo"
        ]
      }
    }
  }
}
